<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RvcStudio.App.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#B7F36B" />
        <ColorPaletteResources x:Key="Light" Accent="#6F9E34" />
      </FluentTheme.Palettes>
    </FluentTheme>

    <!-- Typography and canvas -->
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Background" Value="#0E110F" />
      <Setter Property="Foreground" Value="#EEF2EE" />
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="#EEF2EE" />
    </Style>
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#F4F7F4" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="#A7AFA9" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="#747D77" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="FontSize" Value="9.5" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="1.1" />
      <Setter Property="Foreground" Value="#78817B" />
    </Style>

    <!-- Surfaces -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#151917" />
      <Setter Property="BorderBrush" Value="#282F2B" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Padding" Value="13" />
      <Setter Property="BoxShadow" Value="0 7 24 0 #26000000" />
    </Style>
    <Style Selector="Border.inset">
      <Setter Property="Background" Value="#111412" />
      <Setter Property="BorderBrush" Value="#252B27" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector="Border.value-pill">
      <Setter Property="Background" Value="#202622" />
      <Setter Property="BorderBrush" Value="#303832" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="MinWidth" Value="48" />
      <Setter Property="Height" Value="30" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.value-pill > TextBlock">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="Background" Value="#1E2B1A" />
      <Setter Property="BorderBrush" Value="#344A2A" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="99" />
      <Setter Property="Padding" Value="7,3" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.badge > TextBlock">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <!-- Buttons -->
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="11,6" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="#202522" />
      <Setter Property="BorderBrush" Value="#323935" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#DDE3DE" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="#29302C" />
      <Setter Property="BorderBrush" Value="#414B45" />
    </Style>
    <Style Selector="Button:pressed">
      <Setter Property="Background" Value="#343C37" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="16,7" />
      <Setter Property="Background" Value="#B7F36B" />
      <Setter Property="BorderBrush" Value="#D1FF98" />
      <Setter Property="Foreground" Value="#142009" />
    </Style>
    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="#C5FA82" />
      <Setter Property="BorderBrush" Value="#E0FFB7" />
    </Style>
    <Style Selector="Button.primary.stop">
      <Setter Property="Background" Value="#FF7770" />
      <Setter Property="BorderBrush" Value="#FFA29D" />
      <Setter Property="Foreground" Value="#2A0B09" />
    </Style>
    <Style Selector="Button.quiet">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="#AEB6B0" />
    </Style>
    <Style Selector="Button.quiet:pointerover">
      <Setter Property="Background" Value="#1E2420" />
      <Setter Property="Foreground" Value="#F0F5F1" />
    </Style>
    <Style Selector="Button.icon">
      <Setter Property="Width" Value="34" />
      <Setter Property="MinWidth" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="#A9B1AB" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="Button.nav:pointerover">
      <Setter Property="Background" Value="#1A1F1C" />
      <Setter Property="Foreground" Value="#F0F4F0" />
    </Style>
    <Style Selector="Button.nav.selected">
      <Setter Property="Background" Value="#21291F" />
      <Setter Property="BorderBrush" Value="#34412F" />
      <Setter Property="Foreground" Value="#DDF7BC" />
    </Style>

    <!-- Form controls -->
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="35" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="#111513" />
      <Setter Property="BorderBrush" Value="#2C332F" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#E3E8E4" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="SelectionBrush" Value="#557CBE32" />
    </Style>
    <Style Selector="TextBox:pointerover">
      <Setter Property="BorderBrush" Value="#414A44" />
    </Style>
    <Style Selector="TextBox:focus">
      <Setter Property="BorderBrush" Value="#86B94F" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="35" />
      <Setter Property="Padding" Value="9,5" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="#111513" />
      <Setter Property="BorderBrush" Value="#2C332F" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#E3E8E4" />
      <Setter Property="FontSize" Value="11.5" />
    </Style>
    <Style Selector="ComboBox:pointerover">
      <Setter Property="BorderBrush" Value="#414A44" />
      <Setter Property="Background" Value="#151A17" />
    </Style>
    <Style Selector="ComboBoxItem">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="9,6" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="ComboBoxItem:selected">
      <Setter Property="Background" Value="#263422" />
      <Setter Property="Foreground" Value="#DDF7BC" />
    </Style>
    <Style Selector="ToggleSwitch">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="#B7BFB9" />
      <Setter Property="OnContent" Value="" />
      <Setter Property="OffContent" Value="" />
    </Style>
    <Style Selector="Slider">
      <Setter Property="Foreground" Value="#AEEA64" />
      <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style Selector="ProgressBar">
      <Setter Property="Height" Value="4" />
      <Setter Property="CornerRadius" Value="99" />
      <Setter Property="Background" Value="#242A26" />
      <Setter Property="Foreground" Value="#AEEA64" />
    </Style>
  </Application.Styles>
</Application>
