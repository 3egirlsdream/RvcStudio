<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RvcStudio.App.UpdateNoticeWindow"
        Width="510" Height="470" CanResize="False" WindowStartupLocation="CenterOwner"
        Title="RVC Studio 更新">
  <Grid RowDefinitions="Auto,*,Auto" Background="#0E110F">
    <StackPanel Grid.Row="0" Margin="22,20,22,12" Spacing="6">
      <TextBlock Text="RVC STUDIO UPDATE" Classes="eyebrow" />
      <TextBlock Text="发现新版本" FontSize="22" FontWeight="SemiBold" />
      <TextBlock x:Name="VersionText" Foreground="#B7F36B" />
    </StackPanel>
    <StackPanel Grid.Row="1" Margin="22,8" Spacing="14">
      <Border Classes="inset" Padding="14">
        <ScrollViewer MaxHeight="120"><TextBlock x:Name="MemoText" TextWrapping="Wrap" /></ScrollViewer>
      </Border>
      <TextBlock x:Name="SizeText" FontWeight="SemiBold" />
      <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#C8D0CA" />
      <ProgressBar x:Name="DownloadProgress" Minimum="0" Maximum="100" Height="6" IsVisible="False" />
      <Button x:Name="CancelButton" Click="Cancel_Click" IsVisible="False">取消下载</Button>
    </StackPanel>
    <Border Grid.Row="2" BorderBrush="#29302B" BorderThickness="0,1,0,0" Padding="22,14">
      <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
        <Button x:Name="LaterButton" Click="Close_Click">暂不更新</Button>
        <Button x:Name="ActionButton" Classes="primary" Click="Action_Click">下载更新</Button>
      </StackPanel>
    </Border>
  </Grid>
</Window>
