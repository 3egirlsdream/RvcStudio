<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RvcStudio.App.SettingsWindow"
        Width="900" Height="760"
        MinWidth="780" MinHeight="680"
        CanResize="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Title="RVC Studio 设置"
        Opened="Window_Opened"
        Closed="Window_Closed">
  <Window.Styles>
    <Style Selector="Border.settings-card">
      <Setter Property="Background" Value="#151917" />
      <Setter Property="BorderBrush" Value="#2D3530" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="TextBox.parameter-input">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox.parameter-input">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Background="#0E110F">
    <Border Grid.Row="0" Background="#121613" BorderBrush="#29302B" BorderThickness="0,0,0,1" Padding="20,15">
      <Grid ColumnDefinitions="46,*" ColumnSpacing="12">
        <Border Width="42" Height="42" CornerRadius="11" Background="#26351F" BorderBrush="#415634" BorderThickness="1">
          <TextBlock Text="⚙" Foreground="#B8F36A" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
          <TextBlock Classes="eyebrow" Text="RVC STUDIO SETTINGS" />
          <TextBlock Text="设置" FontSize="19" FontWeight="SemiBold" />
          <TextBlock Text="导入、导出模型并管理软件更新" Classes="muted" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="20,16" Spacing="12">
        <Border Classes="settings-card">
          <StackPanel Spacing="13">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="3">
                <TextBlock Classes="section-title" Text="导入模型 ZIP" />
                <TextBlock Classes="muted" Text="压缩包需包含一个 PTH、一个 INDEX，可选一个配置 JSON。" />
              </StackPanel>
              <Button Grid.Column="1" x:Name="ChooseImportZipButton" Classes="primary" Click="ChooseImportZip_Click" MinWidth="118">选择 ZIP</Button>
            </Grid>

            <Grid ColumnDefinitions="100,*" ColumnSpacing="10">
              <TextBlock Classes="label" Text="压缩包" VerticalAlignment="Center" />
              <TextBox Grid.Column="1"
                       x:Name="ImportZipPathText"
                       Classes="parameter-input"
                       IsReadOnly="True"
                       PlaceholderText="尚未选择压缩包" />
            </Grid>

            <StackPanel x:Name="ImportPreviewPanel" IsVisible="False" Spacing="12">
              <Border Classes="inset" Padding="12">
                <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="5">
                  <TextBlock Classes="label" Text="检测到 PTH" />
                  <TextBlock Grid.Column="1" x:Name="ImportPthText" TextWrapping="Wrap" />
                  <TextBlock Grid.Row="1" Classes="label" Text="检测到 INDEX" />
                  <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ImportIndexText" TextWrapping="Wrap" />
                  <TextBlock Grid.Row="2" Classes="label" Text="配置 JSON" />
                  <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ImportJsonText" TextWrapping="Wrap" />
                </Grid>
              </Border>

              <Grid ColumnDefinitions="100,*" ColumnSpacing="10">
                <TextBlock Classes="label" Text="导入名称" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" x:Name="ImportModelNameText" Classes="parameter-input" PlaceholderText="模型文件主名" />
              </Grid>

              <TextBlock Classes="label" Text="模型单独参数" />
              <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="9">
                <StackPanel Spacing="4">
                  <TextBlock Classes="muted" Text="音高算法" />
                  <ComboBox x:Name="ImportPitchMethodCombo" Classes="parameter-input" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Classes="muted" Text="Pitch · -16 ~ 16" />
                  <TextBox x:Name="ImportPitchText" Classes="parameter-input" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4">
                  <TextBlock Classes="muted" Text="Formant · -2 ~ 2" />
                  <TextBox x:Name="ImportFormantText" Classes="parameter-input" />
                </StackPanel>

                <StackPanel Grid.Row="1" Spacing="4">
                  <TextBlock Classes="muted" Text="Index · 0 ~ 1" />
                  <TextBox x:Name="ImportIndexRateText" Classes="parameter-input" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                  <TextBlock Classes="muted" Text="RMS · 0 ~ 1" />
                  <TextBox x:Name="ImportRmsMixRateText" Classes="parameter-input" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Spacing="4">
                  <TextBlock Classes="muted" Text="门限 · -80 ~ -20" />
                  <TextBox x:Name="ImportThresholdText" Classes="parameter-input" />
                </StackPanel>

                <StackPanel Grid.Row="2" Spacing="4">
                  <TextBlock Classes="muted" Text="分块秒数 · 0.02 ~ 1.5" />
                  <TextBox x:Name="ImportBlockTimeText" Classes="parameter-input" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                  <TextBlock Classes="muted" Text="交叉淡化 · 0.01 ~ 0.15" />
                  <TextBox x:Name="ImportCrossfadeText" Classes="parameter-input" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2" Spacing="4">
                  <TextBlock Classes="muted" Text="额外推理 · 0.05 ~ 5" />
                  <TextBox x:Name="ImportExtraTimeText" Classes="parameter-input" />
                </StackPanel>
              </Grid>

              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock x:Name="ImportStatusText" Foreground="#9CA69F" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" x:Name="ImportButton" Classes="primary" Click="ImportModel_Click" MinWidth="118">确认导入</Button>
              </Grid>
              <ProgressBar x:Name="ImportProgress" IsVisible="False" IsIndeterminate="True" Height="3" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="settings-card">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="3">
                <TextBlock Classes="section-title" Text="批量导出模型" />
                <TextBlock Classes="muted" Text="每个勾选模型生成一个同名 ZIP；缺少 INDEX 的模型不可导出。" />
              </StackPanel>
              <Button Grid.Column="1" x:Name="RefreshModelsButton" Click="RefreshModels_Click" MinWidth="96">刷新列表</Button>
            </Grid>

            <Border Classes="inset" Padding="10">
              <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ExportModelList" Spacing="4" />
              </ScrollViewer>
            </Border>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <TextBlock x:Name="ExportStatusText" Text="勾选模型后选择导出文件夹。" Foreground="#9CA69F" TextWrapping="Wrap" VerticalAlignment="Center" />
              <Button Grid.Column="1" x:Name="ExportButton" Classes="primary" Click="ExportModels_Click" MinWidth="138">导出所选模型</Button>
            </Grid>
            <ProgressBar x:Name="ExportProgress" IsVisible="False" Minimum="0" Maximum="1" Height="3" />
          </StackPanel>
        </Border>

        <Border Classes="settings-card">
          <StackPanel Spacing="13">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="3">
                <TextBlock Classes="section-title" Text="软件更新" />
                <TextBlock Classes="muted" Text="手动连接更新服务器，检查是否有新版本。" />
              </StackPanel>
              <Border Grid.Column="1" Classes="badge" Padding="9,4">
                <TextBlock Text="稳定版" Foreground="#BFEF83" FontSize="9" FontWeight="Bold" />
              </Border>
            </Grid>

            <Border Classes="inset" Padding="12">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="3" VerticalAlignment="Center">
                  <TextBlock Classes="label" Text="当前版本" />
                  <TextBlock x:Name="CurrentVersionText" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
                <Button x:Name="CheckUpdatesButton" Grid.Column="1" Classes="primary" MinWidth="118" Click="CheckUpdates_Click">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <TextBlock Text="↻" FontSize="15" Foreground="{Binding $parent[Button].Foreground}" VerticalAlignment="Center" />
                    <TextBlock x:Name="CheckUpdatesButtonText" Text="检查更新" Foreground="{Binding $parent[Button].Foreground}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </Grid>
            </Border>

            <Border x:Name="UpdateStatusPanel" Background="#171D19" BorderBrush="#303A33" BorderThickness="1" CornerRadius="8" Padding="11,9">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                <Ellipse x:Name="UpdateStatusIndicator" Width="8" Height="8" Fill="#78817B" VerticalAlignment="Center" />
                <TextBlock x:Name="UpdateStatusText" Grid.Column="1" Text="点击“检查更新”获取最新版本信息。" Foreground="#9CA69F" TextWrapping="Wrap" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <ProgressBar x:Name="UpdateProgress" IsVisible="False" IsIndeterminate="True" Height="3" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" BorderBrush="#29302B" BorderThickness="0,1,0,0" Padding="20,12">
      <Button HorizontalAlignment="Right" MinWidth="92" Click="Close_Click">关闭</Button>
    </Border>
  </Grid>
</Window>
