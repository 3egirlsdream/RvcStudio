<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RvcStudio.App.StoreWindow" Title="RVC Studio · 音色商城"
        Width="990" Height="760" MinWidth="760" MinHeight="580" WindowStartupLocation="CenterOwner">
  <Grid Background="#0E110F" RowDefinitions="Auto,Auto,*,Auto">
    <Border Grid.Row="0" Padding="24,20" Background="#141A15" BorderBrush="#2E3B2F" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="5"><TextBlock Text="VOICE COLLECTION" Classes="eyebrow"/><TextBlock Text="发现你的下一种声音" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="试听、下载，在工作台中直接使用。" Classes="muted"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Button x:Name="ManageButton" Click="Manage_Click" IsVisible="False">商城管理</Button>
          <Button Click="Account_Click">账号 / 会员</Button><Button Click="Refresh_Click">刷新</Button>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="24,14" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
      <TextBox x:Name="SearchBox" PlaceholderText="搜索音色名称" TextChanged="Filter_Changed"/>
      <CheckBox Grid.Column="1" x:Name="DownloadedOnly" Content="已下载" IsCheckedChanged="Filter_Changed"/>
      <CheckBox Grid.Column="2" x:Name="FreeOnly" Content="免费" IsCheckedChanged="Filter_Changed"/>
    </Grid>
    <ScrollViewer Grid.Row="2" Margin="17,0,17,12" HorizontalScrollBarVisibility="Disabled">
      <WrapPanel x:Name="Cards" Orientation="Horizontal"/>
    </ScrollViewer>
    <Border Grid.Row="3" Padding="24,12" Background="#141A15"><TextBlock x:Name="StatusText" Text="正在读取音色…" TextWrapping="Wrap" Foreground="#BBC8BD"/></Border>
  </Grid>
</Window>
